<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.speedtest.diagnostics</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>__INSTALL_DIR__/scripts/run_mac.sh</string>
    </array>
    
    <key>StartInterval</key>
    <integer>1800</integer>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>StandardOutPath</key>
    <string>/tmp/speedtest_diagnostics.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/speedtest_diagnostics.err</string>
</dict>
</plist>
